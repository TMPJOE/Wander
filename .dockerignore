# Build artifacts and files we don't want copied into the Docker build context.
# Keeps image builds small and cache-friendly.

# Local environment / secrets — NEVER bake into the image.
.env
.env.*
!.env.example

# Git / CI
.git/
.gitignore
.github/
.gitlab-ci.yml

# Editor / OS cruft
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Backend local artifacts
backend/bin/
backend/tmp/
backend/*.exe
backend/*.test
backend/*.out
backend/coverage.html
backend/uploads/
backend/vendor/

# Frontend local artifacts (the Dockerfile rebuilds dist/ in-stage).
frontend/node_modules/
frontend/dist/
frontend/.pnpm-store/
frontend/coverage/
frontend/*.local

# Docs / agents / skills — not needed at runtime
AGENTS.md
README.md
implementation_plan.md
.agents/
.kilo/
.skills-lock.json
setup_db.bat

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
