    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "A browser action enters the Vue SPA, crosses the JSON API, is authorized, and reaches a domain service.",
        "Transactional state is persisted in PostgreSQL; media and payment calls branch at the domain boundary."
      ]
    },
    {
      "dot": "violet",
      "title": "Runtime ownership",
      "items": [
        "Frontend owns navigation, user interaction, API composition, and map presentation.",
        "Backend owns authorization, business rules, persistence orchestration, payments, messaging, and uploads."
      ]
    },
    {
      "dot": "amber",
      "title": "Evidence in repository",
      "items": [
