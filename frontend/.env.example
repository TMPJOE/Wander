# Vite Environment Variables
# All variables must be prefixed with VITE_

# API Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Stripe (test mode publishable key)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Application
VITE_APP_NAME=Wander
VITE_APP_ENV=development

# Google Maps (optional - for map picker and directions)
# Restrict this key in Google Cloud Console to allowed origins and enable only:
# - Maps JavaScript API
# - Places API
VITE_GOOGLE_MAPS_API_KEY=
