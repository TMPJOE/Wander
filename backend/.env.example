APP_NAME=Wander
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=5432
DB_USER=wander_user
DB_PASSWORD=wander_pass
DB_NAME=wander_db
DB_SSLMODE=disable
DB_SSLROOTCERT=certs/ca.crt


STORAGE_DRIVER=local
