JWT_SECRET=change-me-in-production-very-secret-key
JWT_EXPIRATION_HOURS=24

# Stripe (test mode keys — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
